# Local synthetic preview. Never commit real credentials.
DATABASE_URL=postgresql://ledger@127.0.0.1:5432/ledger_browser
APP_URL=http://127.0.0.1:3000
DEMO_MODE=true

# Configure these securely on Vercel before enabling Google login / dedicated Gmail.
ALLOWED_EMAILS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Base64-encoded cryptographically random key material (AUTH_SECRET >=32 bytes; TOKEN_ENCRYPTION_KEY exactly32).
AUTH_SECRET=
TOKEN_ENCRYPTION_KEY=
# Random credential with at least24 characters; required for the scheduler.
CRON_SECRET=
